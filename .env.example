# Copy to .env (never commit .env):   cp .env.example .env
DB_USER=zitouna
DB_PASSWORD=zitouna
# At least 32 random characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more

# Back-office admin (http://localhost:4200/admin): created at backend start-up. Password: 8 characters minimum.
ADMIN_EMAIL=admin@zitouna.tn
ADMIN_PASSWORD=

# LLM for the assistant replies (M5). Leave empty to use template replies only.
# Free keys: https://aistudio.google.com/apikey (Gemini) · https://console.groq.com (Groq) · https://openrouter.ai · https://z.ai/manage-apikey/apikey-list (GLM, M4)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=
ZAI_API_KEY=
# Optional: override the rotation order, JSON list of {"provider","model","extra"} (see ai-services/m5-assistant/app/llm.py)
LLM_CHAIN=

# Trained models on Hugging Face (python scripts/models.py pull/push, see models/README.md)
HF_MODELS_REPO=
HF_TOKEN=

# Host ports (change them if another program already uses one, e.g. a local PostgreSQL or Oracle on 8080)
DB_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=4200
